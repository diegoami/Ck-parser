# Copy to .env and fill in. Never commit the real .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Prose (python -m ck3wiki.prose), read with: uv run --env-file .env python -m ...
# OpenCode Zen, pay-as-you-go; DeepSeek, GLM, Kimi and MiniMax speak chat/completions.
CK3_PROSE_BACKEND=openai
CK3_PROSE_URL=https://opencode.ai/zen/v1
CK3_PROSE_MODEL=deepseek-v4-flash
CK3_PROSE_API_KEY=your-opencode-zen-key
